<Window x:Class="CrosshairManager.App.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:CrosshairManager.App.Views"
        AutomationProperties.AutomationId="RenameDialog"
        Title="{v:Str Preset.RenameTitle}"
        FontFamily="{StaticResource FontBody}"
        FontSize="{StaticResource TextBody}"
        Background="{StaticResource BrushSurface}"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Width="360">
  <StackPanel Margin="{StaticResource Pad3}">
    <TextBlock Style="{StaticResource TextBodyStyle}" Text="{v:Str Preset.RenamePrompt}" Margin="{StaticResource GapBelow2}" />
    <TextBox x:Name="NameBox"
             AutomationProperties.AutomationId="RenameText"
             Style="{StaticResource CompactTextBoxStyle}"
             Margin="{StaticResource GapBelow3}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button AutomationProperties.AutomationId="RenameOk"
              Style="{StaticResource PrimaryButtonStyle}"
              Margin="{StaticResource GapRight2}"
              IsDefault="True"
              Content="{v:Str Dialog.Ok}"
              Click="OnOk" />
      <Button AutomationProperties.AutomationId="RenameCancel"
              Style="{StaticResource PrimaryButtonStyle}"
              IsCancel="True"
              Content="{v:Str Dialog.Cancel}" />
    </StackPanel>
  </StackPanel>
</Window>
