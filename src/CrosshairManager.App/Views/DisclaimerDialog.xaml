<Window x:Class="CrosshairManager.App.Views.DisclaimerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:CrosshairManager.App.Views"
        AutomationProperties.AutomationId="DisclaimerDialog"
        Title="{v:Str Disclaimer.Title}"
        FontFamily="{StaticResource FontBody}"
        FontSize="{StaticResource TextBody}"
        Background="{StaticResource BrushSurface}"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Width="520">
  <StackPanel Margin="{StaticResource Pad3}">
    <TextBlock Style="{StaticResource TitleStyle}" Text="{v:Str Disclaimer.Title}" Margin="{StaticResource GapBelow3}" />
    <TextBlock Style="{StaticResource TextBodyStyle}" TextWrapping="Wrap" Text="{v:Str Disclaimer.Fullscreen}" Margin="{StaticResource GapBelow2}" />
    <TextBlock Style="{StaticResource TextBodyStyle}" TextWrapping="Wrap" Text="{v:Str Disclaimer.AntiCheat}" Margin="{StaticResource GapBelow2}" />
    <TextBlock Style="{StaticResource TextBodyStyle}" TextWrapping="Wrap" Text="{v:Str Disclaimer.Hotkeys}" Margin="{StaticResource GapBelow3}" />
    <Button AutomationProperties.AutomationId="DisclaimerOk"
            Style="{StaticResource PrimaryButtonStyle}"
            HorizontalAlignment="Right"
            IsDefault="True"
            Content="{v:Str Disclaimer.Ok}"
            Click="OnOk" />
  </StackPanel>
</Window>
