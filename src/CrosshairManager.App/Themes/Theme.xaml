<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Design tokens for the settings UI. Every view references these; no literal colors, sizes or spacing in views. -->

  <!-- Spacing scale (4 px grid) -->
  <sys:Double x:Key="Space1">4</sys:Double>
  <sys:Double x:Key="Space2">8</sys:Double>
  <sys:Double x:Key="Space3">12</sys:Double>
  <sys:Double x:Key="Space4">16</sys:Double>
  <Thickness x:Key="Pad1">4</Thickness>
  <Thickness x:Key="Pad2">8</Thickness>
  <Thickness x:Key="Pad3">12</Thickness>
  <Thickness x:Key="GapBelow1">0,0,0,4</Thickness>
  <Thickness x:Key="GapBelow2">0,0,0,8</Thickness>
  <Thickness x:Key="GapBelow3">0,0,0,12</Thickness>
  <Thickness x:Key="GapRight1">0,0,4,0</Thickness>
  <Thickness x:Key="GapRight2">0,0,8,0</Thickness>
  <Thickness x:Key="GapLeft2">8,0,0,0</Thickness>
  <Thickness x:Key="InputPadding">4,2</Thickness>
  <Thickness x:Key="GapBelowHalf">0,0,0,2</Thickness>
  <Thickness x:Key="GapAbove1">0,4,0,0</Thickness>
  <Thickness x:Key="GapAbove2">0,8,0,0</Thickness>
  <Thickness x:Key="CellLeft">0,0,2,4</Thickness>
  <Thickness x:Key="CellRight">2,0,0,4</Thickness>
  <Thickness x:Key="ColumnGap">0,0,12,0</Thickness>
  <Thickness x:Key="CellGap">0,0,4,2</Thickness>
  <Thickness x:Key="NoGap">0</Thickness>

  <!-- Typography -->
  <FontFamily x:Key="FontBody">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>
  <sys:Double x:Key="TextCaption">11</sys:Double>
  <sys:Double x:Key="TextBody">12</sys:Double>
  <sys:Double x:Key="TextSubtitle">14</sys:Double>
  <sys:Double x:Key="TextTitle">20</sys:Double>

  <!-- Color palette: neutrals + one accent + semantic -->
  <Color x:Key="ColorSurface">#F7F7F9</Color>
  <Color x:Key="ColorSurfaceRaised">#FFFFFF</Color>
  <Color x:Key="ColorSurfaceSunken">#ECECF1</Color>
  <Color x:Key="ColorStage">#1E1E24</Color>
  <Color x:Key="ColorStageAlt">#2A2A32</Color>
  <Color x:Key="ColorBorder">#D4D4DC</Color>
  <Color x:Key="ColorText">#1B1B1F</Color>
  <Color x:Key="ColorTextSecondary">#5F5F6B</Color>
  <Color x:Key="ColorAccent">#2E7D32</Color>
  <Color x:Key="ColorAccentSoft">#E3F2E4</Color>
  <Color x:Key="ColorError">#B3261E</Color>
  <Color x:Key="ColorErrorSoft">#FBE9E7</Color>
  <Color x:Key="ColorWarning">#8A5A00</Color>
  <Color x:Key="ColorWarningSoft">#FFF4D6</Color>
  <Color x:Key="ColorInfoSoft">#E8EEF9</Color>

  <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
  <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
  <SolidColorBrush x:Key="BrushSurfaceSunken" Color="{StaticResource ColorSurfaceSunken}" />
  <SolidColorBrush x:Key="BrushStage" Color="{StaticResource ColorStage}" />
  <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
  <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
  <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
  <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
  <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}" />
  <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />
  <SolidColorBrush x:Key="BrushErrorSoft" Color="{StaticResource ColorErrorSoft}" />
  <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
  <SolidColorBrush x:Key="BrushWarningSoft" Color="{StaticResource ColorWarningSoft}" />
  <SolidColorBrush x:Key="BrushInfoSoft" Color="{StaticResource ColorInfoSoft}" />

  <!-- Checkerboard stage behind pixel previews (16 device-independent px tiles) -->
  <DrawingBrush x:Key="BrushCheckerboard" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource BrushStage}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,16,16" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Brush>
            <SolidColorBrush Color="{StaticResource ColorStageAlt}" />
          </GeometryDrawing.Brush>
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="0,0,8,8" />
              <RectangleGeometry Rect="8,8,8,8" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Shape -->
  <CornerRadius x:Key="RadiusSmall">3</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
  <sys:Double x:Key="SwatchSize">28</sys:Double>
  <sys:Double x:Key="ThumbnailSize">40</sys:Double>
  <sys:Double x:Key="FieldLabelWidth">56</sys:Double>
  <sys:Double x:Key="FieldBoxWidth">42</sys:Double>
  <sys:Double x:Key="RowHeight">22</sys:Double>
  <sys:Double x:Key="TileWidth">68</sys:Double>
  <sys:Double x:Key="PreviewSize">168</sys:Double>
  <GridLength x:Key="FieldLabelColumn">56</GridLength>
  <GridLength x:Key="LineNameColumn">80</GridLength>
  <GridLength x:Key="PresetsColumn">196</GridLength>
  <GridLength x:Key="PreviewColumn">180</GridLength>

  <!-- Text styles -->
  <Style x:Key="TextBodyStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="TextCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodyStyle}">
    <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
  </Style>
  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodyStyle}">
    <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    <Setter Property="Margin" Value="{StaticResource GapBelow1}" />
  </Style>
  <Style x:Key="TitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodyStyle}">
    <Setter Property="FontSize" Value="{StaticResource TextSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaptionStyle}">
    <Setter Property="Foreground" Value="{StaticResource BrushError}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="WarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaptionStyle}">
    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Section: accent caption header + thin rule, lighter than GroupBox -->
  <Style x:Key="SectionRuleStyle" TargetType="Separator">
    <Setter Property="Background" Value="{StaticResource BrushBorder}" />
    <Setter Property="Margin" Value="{StaticResource GapBelow1}" />
  </Style>

  <!-- Compact controls -->
  <Style x:Key="CompactTextBoxStyle" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    <Setter Property="Height" Value="{StaticResource RowHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="CompactSliderStyle" TargetType="Slider">
    <Setter Property="Height" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="TickFrequency" Value="1" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
  </Style>
  <Style x:Key="CompactCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="{StaticResource RowHeight}" />
    <Setter Property="Margin" Value="{StaticResource GapBelow1}" />
  </Style>
  <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Height" Value="{StaticResource RowHeight}" />
    <Setter Property="Padding" Value="{StaticResource InputPadding}" />
  </Style>
  <Style x:Key="ToolButtonStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    <Setter Property="Height" Value="{StaticResource RowHeight}" />
    <Setter Property="MinWidth" Value="56" />
  </Style>
  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="HotkeyBoxStyle" TargetType="TextBox" BasedOn="{StaticResource CompactTextBoxStyle}">
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Background" Value="{StaticResource BrushSurfaceRaised}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsFailed}" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource BrushError}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{StaticResource BrushErrorSoft}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Color swatch: round button filled with its color; accent ring when selected -->
  <Style x:Key="SwatchButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="{StaticResource SwatchSize}" />
    <Setter Property="Height" Value="{StaticResource SwatchSize}" />
    <Setter Property="Margin" Value="{StaticResource GapRight2}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse x:Name="Ring" Stroke="{StaticResource BrushBorder}" StrokeThickness="2" Fill="Transparent" />
            <Ellipse Margin="4" Fill="{TemplateBinding Background}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource BrushTextSecondary}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource BrushAccent}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Preset tile (Simple tab built-ins) -->
  <Style x:Key="TileButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource BrushSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="Padding" Value="{StaticResource Pad1}" />
    <Setter Property="Margin" Value="{StaticResource GapRight2}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
