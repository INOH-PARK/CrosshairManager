<UserControl x:Class="CrosshairManager.App.Controls.PreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <Border Background="{StaticResource BrushCheckerboard}"
          BorderBrush="{StaticResource BrushBorder}"
          BorderThickness="1"
          CornerRadius="{StaticResource RadiusSmall}"
          ClipToBounds="True">
    <Image x:Name="PixelImage"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           RenderOptions.BitmapScalingMode="NearestNeighbor"
           UseLayoutRounding="True"
           SnapsToDevicePixels="True"
           AutomationProperties.AutomationId="{Binding PreviewAutomationId, ElementName=Root}" />
  </Border>
</UserControl>
