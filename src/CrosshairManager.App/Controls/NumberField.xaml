<UserControl x:Class="CrosshairManager.App.Controls.NumberField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Height="{StaticResource RowHeight}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="LabelText"
               Grid.Column="0"
               Style="{StaticResource TextCaptionStyle}"
               Width="{StaticResource FieldLabelWidth}"
               TextTrimming="CharacterEllipsis"
               Text="{Binding Label, ElementName=Root}"
               ToolTip="{Binding Label, ElementName=Root}" />
    <Slider Grid.Column="1"
            Style="{StaticResource CompactSliderStyle}"
            Margin="{StaticResource GapRight1}"
            Minimum="{Binding Minimum, ElementName=Root}"
            Maximum="{Binding Maximum, ElementName=Root}"
            Value="{Binding Value, ElementName=Root, Mode=TwoWay}" />
    <TextBox Grid.Column="2"
             Style="{StaticResource CompactTextBoxStyle}"
             Width="{StaticResource FieldBoxWidth}"
             TextAlignment="Right"
             AutomationProperties.AutomationId="{Binding FieldId, ElementName=Root}"
             AutomationProperties.Name="{Binding Label, ElementName=Root}"
             Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
  </Grid>
</UserControl>
