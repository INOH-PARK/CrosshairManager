<UserControl x:Class="CrosshairManager.App.Controls.InfoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             AutomationProperties.AutomationId="InfoBar"
             AutomationProperties.Name="{Binding Text, ElementName=Root}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <Border x:Name="Shell"
          Background="{StaticResource BrushInfoSoft}"
          BorderBrush="{StaticResource BrushBorder}"
          BorderThickness="1"
          CornerRadius="{StaticResource RadiusSmall}"
          Padding="{StaticResource Pad2}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 AutomationProperties.AutomationId="InfoBarNotice"
                 Style="{StaticResource TextCaptionStyle}"
                 TextTrimming="CharacterEllipsis"
                 Text="{Binding Notice, ElementName=Root}"
                 ToolTip="{Binding Notice, ElementName=Root}" />
      <StackPanel Grid.Row="1"
                  Grid.Column="0"
                  Margin="{StaticResource GapAbove1}"
                  Visibility="{Binding HasMessage, ElementName=Root, Converter={StaticResource BoolToVis}}">
        <TextBlock AutomationProperties.AutomationId="InfoBarMessage"
                   Style="{StaticResource TextBodyStyle}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Text="{Binding Message, ElementName=Root}" />
        <TextBlock AutomationProperties.AutomationId="InfoBarDetail"
                   Style="{StaticResource TextCaptionStyle}"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding Detail, ElementName=Root}"
                   ToolTip="{Binding Detail, ElementName=Root}"
                   Visibility="{Binding HasDetail, ElementName=Root, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
      <Button Grid.Row="1"
              Grid.Column="1"
              AutomationProperties.AutomationId="InfoBarDismiss"
              Style="{StaticResource ToolButtonStyle}"
              Margin="{StaticResource GapLeft2}"
              VerticalAlignment="Top"
              Content="{Binding DismissLabel, ElementName=Root}"
              Command="{Binding DismissCommand, ElementName=Root}"
              Visibility="{Binding HasMessage, ElementName=Root, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </Border>
</UserControl>
